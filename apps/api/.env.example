# Postgres connection.
# Using a local Postgres on the default port:
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"
# Or use the bundled docker-compose (exposes 5433 to avoid clashing with a local 5432):
# DATABASE_URL="postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3002
NODE_ENV="development"

# Comma separated list of allowed origins for CORS
CORS_ORIGIN="http://localhost:5173"

# Comma separated list. The first entry is used to seed the admin account.
ADMIN_EMAIL="admin@portfolio.local"
ADMIN_PASSWORD="change-me-now"
ADMIN_NAME="Farid Ghaderi"

# httpOnly cookie flags. Set COOKIE_SECURE=true in production over HTTPS.
COOKIE_SECURE=false
